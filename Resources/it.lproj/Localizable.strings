"r.ViewDistanceScale: multiplies the maximum draw distance (default 1)." = "r.ViewDistanceScale: moltiplica la distanza massima di disegno (default 1).";
"r.StaticMeshLODDistanceScale: lower values keep full detail longer (default 1)." = "r.StaticMeshLODDistanceScale: valori più bassi = dettaglio pieno più a lungo (default 1).";
"r.SkeletalMeshLODBias: -1 = more detail, positive = less." = "r.SkeletalMeshLODBias: -1 = più dettaglio, positivo = meno.";
"r.Shadow.MaxResolution in texels (default 2048)." = "r.Shadow.MaxResolution in texel (default 2048).";
"r.Shadow.DistanceScale: <1 shorter, >1 longer (default 1)." = "r.Shadow.DistanceScale: <1 più corta, >1 più lunga (default 1).";
